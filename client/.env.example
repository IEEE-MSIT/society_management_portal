# Clerk publishable key (front-end only, safe to expose).
# In production this MUST be set as a Vercel Environment Variable.
VITE_CLERK_PUBLISHABLE_KEY=

# Backend API base URL (must point to the DEPLOYED backend, e.g. https://your-render-app.onrender.com/api/v1)
# In production this MUST be set as a Vercel Environment Variable — do NOT use localhost here.
VITE_API_URL=
